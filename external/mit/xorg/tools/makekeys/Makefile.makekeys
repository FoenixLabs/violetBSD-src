#	$NetBSD: Makefile.makekeys,v 1.3 2015/06/24 22:20:25 matt Exp $

DPSRCS+=	ks_tables.h
CLEANFILES+=	ks_tables.h

# Match libX11 configure.ac: include vendor keysyms used by XKB compat maps.
KSDEF= ${DESTDIR}${X11INCDIR}/X11/keysymdef.h \
       ${DESTDIR}${X11INCDIR}/X11/XF86keysym.h \
       ${DESTDIR}${X11INCDIR}/X11/Sunkeysym.h \
       ${DESTDIR}${X11INCDIR}/X11/DECkeysym.h \
       ${DESTDIR}${X11INCDIR}/X11/HPkeysym.h

ks_tables.h: ${KSDEF} ${NETBSDSRCDIR}/external/mit/xorg/tools/makekeys/Makefile.makekeys
	${_MKTARGET_CREATE}
	rm -f ${.TARGET}
	${TOOL_MAKEKEYS} ${KSDEF} > ${.TARGET}
